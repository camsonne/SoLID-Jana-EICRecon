<lccdd>
  <!-- DDVCS muon detector (solid_gemc prototype/muon_pro): three forward-angle iron absorber layers
       (36 cm each, two half-slabs 250 x 534 cm reusing CLEO-II yoke pieces) each followed by a
       scintillator annulus R = 80-285 cm; a large-angle scintillator cylinder at R = 290 cm outside the
       endcap yoke; a barrel scintillator outside the coil yoke. -->
  <define>
    <constant name="MuFA_z1" value="638*cm"/>
    <constant name="MuFA_z2" value="702*cm"/>
    <constant name="MuFA_z3" value="766*cm"/>
    <constant name="MuFA_iron_half" value="18*cm"/>
  </define>
  <detectors>
    <!-- iron absorbers: two half slabs per layer, alternating split orientation -->
    <detector id="60" name="MuonFAIron1a" type="DD4hep_BoxSegment" material="Iron" vis="MuonIronVis">
      <box x="125*cm" y="267*cm" z="MuFA_iron_half"/><position x="160*cm" y="0" z="MuFA_z1"/>
    </detector>
    <detector id="61" name="MuonFAIron1b" type="DD4hep_BoxSegment" material="Iron" vis="MuonIronVis">
      <box x="125*cm" y="267*cm" z="MuFA_iron_half"/><position x="-160*cm" y="0" z="MuFA_z1"/>
    </detector>
    <detector id="62" name="MuonFAIron2a" type="DD4hep_BoxSegment" material="Iron" vis="MuonIronVis">
      <box x="267*cm" y="125*cm" z="MuFA_iron_half"/><position x="0" y="160*cm" z="MuFA_z2"/>
    </detector>
    <detector id="63" name="MuonFAIron2b" type="DD4hep_BoxSegment" material="Iron" vis="MuonIronVis">
      <box x="267*cm" y="125*cm" z="MuFA_iron_half"/><position x="0" y="-160*cm" z="MuFA_z2"/>
    </detector>
    <detector id="64" name="MuonFAIron3a" type="DD4hep_BoxSegment" material="Iron" vis="MuonIronVis">
      <box x="125*cm" y="267*cm" z="MuFA_iron_half"/><position x="160*cm" y="0" z="MuFA_z3"/>
    </detector>
    <detector id="65" name="MuonFAIron3b" type="DD4hep_BoxSegment" material="Iron" vis="MuonIronVis">
      <box x="125*cm" y="267*cm" z="MuFA_iron_half"/><position x="-160*cm" y="0" z="MuFA_z3"/>
    </detector>
    <!-- scintillator annuli, 5 cm thick, 23 cm behind each iron layer centre -->
    <detector id="66" name="MuonFAScint" type="DD4hep_DiskTracker" readout="MuonHits" vis="MuonScintVis" reflect="false">
      <layer id="1" inner_r="80*cm" outer_r="285*cm" inner_z="MuFA_z1 + 20.5*cm">
        <slice material="MuonScintillator" thickness="5*cm" sensitive="yes"/>
      </layer>
      <layer id="2" inner_r="80*cm" outer_r="285*cm" inner_z="MuFA_z2 + 20.5*cm">
        <slice material="MuonScintillator" thickness="5*cm" sensitive="yes"/>
      </layer>
      <layer id="3" inner_r="80*cm" outer_r="285*cm" inner_z="MuFA_z3 + 20.5*cm">
        <slice material="MuonScintillator" thickness="5*cm" sensitive="yes"/>
      </layer>
    </detector>
    <!-- large-angle cylinder outside the endcap yoke, z = 209..620 cm -->
    <detector id="67" name="MuonLAScint" type="DD4hep_CylinderTracker" readout="MuonHits" vis="MuonScintVis">
      <layer id="4" inner_r="290*cm" outer_r="295*cm" z="411*cm" z0="414.5*cm">
        <slice material="MuonScintillator" thickness="5*cm" sensitive="yes"/>
      </layer>
    </detector>
    <!-- barrel outside the coil yoke, z = -266..182 cm -->
    <detector id="68" name="MuonBarrelScint" type="DD4hep_CylinderTracker" readout="MuonHits" vis="MuonScintVis">
      <layer id="5" inner_r="285*cm" outer_r="290*cm" z="448*cm" z0="-42*cm">
        <slice material="MuonScintillator" thickness="5*cm" sensitive="yes"/>
      </layer>
    </detector>
  </detectors>
  <readouts>
    <readout name="MuonHits">
      <segmentation type="CartesianGridXY" grid_size_x="10*cm" grid_size_y="10*cm"/>
      <id>system:8,layer:4,x:32:-16,y:-16</id>
    </readout>
  </readouts>
</lccdd>
